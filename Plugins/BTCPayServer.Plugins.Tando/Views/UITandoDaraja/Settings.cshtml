@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@model BTCPayServer.Plugins.Tando.Services.DarajaSettings
@{
    ViewData.SetLayoutModel(new LayoutModel("TandoDarajaSettings", "Daraja phone verification"));
}

<h2>Daraja phone verification</h2>
<partial name="_StatusMessage" />

<p class="text-secondary">
    Credentials of a Daraja app from the
    <a href="https://developer.safaricom.co.ke" target="_blank" rel="noreferrer noopener">Safaricom Developer Portal</a>.
    Signup checks that the merchant's phone number is registered under their ID.
</p>

<form method="post" asp-action="Settings" class="mt-4" style="max-width: 500px;">
    <div class="form-group mb-3">
        <label asp-for="ConsumerKey" class="form-label"></label>
        <input asp-for="ConsumerKey" class="form-control" autocomplete="off" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="ConsumerSecret" class="form-label"></label>
        <input asp-for="ConsumerSecret" type="password" class="form-control" autocomplete="new-password" value="" />
        @if (!string.IsNullOrEmpty(Model.ConsumerSecret))
        {
            <div class="form-text">A secret is saved. Leave blank to keep it.</div>
        }
    </div>
    <div class="form-group mb-3">
        <label asp-for="ShortCode" class="form-label"></label>
        <input asp-for="ShortCode" class="form-control" />
        <div class="form-text">The paybill or till number linked to your Daraja app.</div>
    </div>
    <div class="form-check mb-4">
        <input asp-for="UseSandbox" type="checkbox" class="form-check-input" />
        <label asp-for="UseSandbox" class="form-check-label"></label>
        <div class="form-text">Production needs go-live approval from Safaricom.</div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>